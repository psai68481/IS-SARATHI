# =====================================================================
# IS-SARATHI — Environment Configuration Template
# Tech Stack: React, Next.js, TypeScript, Tailwind CSS, Python, FastAPI,
#             PostgreSQL, Redis, Gemini, Hugging Face, Pinecone, spaCy, AWS S3, Docker
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ---------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="IS-SARATHI Indian Standards Recommendation System"
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION
# ---------------------------------------------------------------------
# Generate a secure 64-char key: openssl rand -hex 32
JWT_SECRET_KEY=sarathi_super_secret_jwt_key_sih_2026_cognitive_crew_secure_token_9988
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------
# 3. DATABASE (PostgreSQL with SQLite fallback)
# ---------------------------------------------------------------------
# For Docker / Production PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/is_sarathi
# For instant local testing without PostgreSQL installed, leave empty or use:
# DATABASE_URL=sqlite:///./is_sarathi.db

# ---------------------------------------------------------------------
# 4. CACHE (Redis with in-memory fallback)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ---------------------------------------------------------------------
# 5. AI / LLM — GOOGLE GEMINI
# ---------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
# Used for grounded re-ranking, "Why / Why Not" justification, conflict detection
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# 6. VECTOR DATABASE — PINECONE
# ---------------------------------------------------------------------
# Get your free serverless key at: https://www.pinecone.io/
# Used for fast semantic similarity search over standard scopes
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=is-sarathi-standards

# ---------------------------------------------------------------------
# 7. EMBEDDINGS — HUGGING FACE
# ---------------------------------------------------------------------
# Sentence Transformer model (runs locally via Hugging Face sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Optional Hugging Face token (only needed if downloading gated models):
# HUGGINGFACE_API_KEY=hf_your_token_here

# ---------------------------------------------------------------------
# 8. DOCUMENT STORAGE — AWS S3 (or Local Fallback)
# ---------------------------------------------------------------------
# Get credentials from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=is-sarathi-standards-docs
# Set to true to use local storage folder instead of AWS S3 for zero-setup demo
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=./storage/documents
